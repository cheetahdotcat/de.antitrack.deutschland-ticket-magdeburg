#!/bin/sh
# Make the release signing key, with keytool from the build image. Run once,
# keep the result (and a backup) outside this repository: an app signed with
# a lost key can never be updated in place.
#   scripts/keystore                       -> ~/.local/share/antitrack/release.jks
#   ANTITRACK_KEYSTORE=/abs/path.jks scripts/keystore
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
engine=${CONTAINER_ENGINE:-podman}
image=${ANTITRACK_IMAGE:-localhost/antitrack/droid-build}
ks=${ANTITRACK_KEYSTORE:-$HOME/.local/share/antitrack/release.jks}
alias=${ANTITRACK_KEY_ALIAS:-antitrack}

case "$ks" in /*) ;; *) echo "ANTITRACK_KEYSTORE must be an absolute path" >&2; exit 2 ;; esac
case "$ks" in "$root"/*) echo "refusing to put the keystore inside the repository" >&2; exit 2 ;; esac
[ -e "$ks" ] && { echo "$ks exists; not overwriting" >&2; exit 1; }
"$engine" image exists "$image" || "$engine" build -t "$image" "$root/build"

dir=$(dirname "$ks")
mkdir -p "$dir" && chmod 700 "$dir"
# keytool prompts for the password itself; it never passes through argv.
"$engine" run --rm -it --userns=keep-id -v "$dir:/k:Z" "$image" \
  keytool -genkeypair -keystore "/k/$(basename "$ks")" -alias "$alias" \
  -keyalg RSA -keysize 4096 -validity 10000 -dname "CN=D-Ticket Magdeburg"
chmod 600 "$ks"
echo "keystore: $ks (alias $alias) — back it up."
